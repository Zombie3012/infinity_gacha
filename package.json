{
  "name": "infiniti-gacha-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Infinite Gacha - Hero Management & Survival Strategy RPG Monorepo",
  "workspaces": [
    "packages/shared",
    "packages/server"
  ],
  "scripts": {
    "build": "npm run build -w @infiniti-gacha/shared && npm run build -w @infiniti-gacha/server",
    "test": "npm run test --workspaces --if-present",
    "dev:server": "npm run dev -w packages/server",
    "db:generate": "npm run db:generate -w packages/server",
    "db:migrate": "npm run db:migrate -w packages/server",
    "check:encoding": "node scripts/check-encoding.mjs",
    "verify": "npm run check:encoding && npm run build && npm test",
    "db:seed": "node scripts/apply-seeds.mjs",
    "db:reset-heroes": "node scripts/reset-demo-heroes.mjs",
    "docs:routes": "node scripts/list-routes.mjs",
    "test:godot:pve": "node scripts/test-godot-pve.mjs",
    "test:godot:pve:recovery": "node scripts/test-godot-pve-recovery.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "argon2@0.45.2": true
  }
}
